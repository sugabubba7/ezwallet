{
  "manifest_version": 3,
  "name": "Relay - Context Handoff",
  "version": "0.1.0",
  "description": "Records your AI chats while the browser is open and carries them to the next AI tool. Stays in your browser; erased when it closes.",
  "permissions": [
    "storage"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*",
        "https://gemini.google.com/*",
        "https://claude.ai/*",
        "https://copilot.microsoft.com/*",
        "https://grok.com/*",
        "https://www.perplexity.ai/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "panel.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/wallet-dark-16.png",
    "48": "icons/wallet-dark-48.png",
    "128": "icons/wallet-dark-128.png"
  },
  "action": {
    "default_title": "Relay",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/wallet-dark-16.png",
      "48": "icons/wallet-dark-48.png",
      "128": "icons/wallet-dark-128.png"
    }
  },
  "web_accessible_resources": [
    {
      "resources": [
        "icons/wallet-dark-48.png"
      ],
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*",
        "https://gemini.google.com/*",
        "https://claude.ai/*",
        "https://copilot.microsoft.com/*",
        "https://grok.com/*",
        "https://www.perplexity.ai/*"
      ]
    }
  ],
  "background": {
    "service_worker": "background.js"
  }
}
