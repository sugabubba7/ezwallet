# Secrets: never commit
.env
.env.*
!.env.example
!.env.local.example
# ...except the backend's grading .env: throwaway DB + non-secret settings only
# (real secrets live in backend/.env.local, which stays ignored)
!backend/.env

# Python
__pycache__/
*.pyc
.venv/
.pytest_cache/

# Database (created at runtime)
*.db
*.db-shm
*.db-wal

# Node / Next
node_modules/
.next/
*.tsbuildinfo
out/

.DS_Store

# scratch/dev outputs of the tracker (the graded run1/run2 files ARE committed)
reports/dev-*
traces/dev-*
tracker/.venv/
