# Copy to tracker/.env.local (git-ignored) and fill in. Nothing in this file is a real secret.

# --- Model (pick ONE provider in config.yaml -> model.provider, set its key) ---------------------
GROQ_API_KEY=            # https://console.groq.com/keys  (free tier: ~8k tokens/min, daily caps apply)
GEMINI_API_KEY=          # https://aistudio.google.com/api-keys
OPENROUTER_API_KEY=      # https://openrouter.ai/keys
OPENAI_API_KEY=          # https://platform.openai.com/api-keys

# --- Web search ----------------------------------------------------------------------------------
TAVILY_API_KEY=          # https://app.tavily.com  (starts with tvly-)

# --- The EZ Wallet backend the tracker saves its memory to (the tracker never touches the DB) ------
TRACKER_API_URL=https://ezwallet-api.onrender.com   # or http://127.0.0.1:8000 for a local backend
TRACKER_LOGIN=NYUgrader                             # the account whose Tracker page will show the results
TRACKER_PASSWORD=                                   # that account's password (the course grading login is in README.md)
