# Copy to `.env.local`. Only NEXT_PUBLIC_* values are exposed to the browser.

# Where the Next.js server proxies /api/* requests (server-side only).
BACKEND_URL=http://127.0.0.1:8000

# Google Identity Services OAuth Client ID (public by design; not a secret).
# Must match GOOGLE_CLIENT_ID in backend/.env. Leave blank to hide Google sign-in.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
