# ---------------------------------------------------------------
# EZ Wallet backend configuration. Copy to `.env` and fill in.
# `.env` is git-ignored. Never commit real secrets.
# ---------------------------------------------------------------

# REQUIRED. Random string of 32+ chars used to sign JWTs.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# REQUIRED. Fernet key that encrypts wallet card contents at rest.
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
WALLET_ENCRYPTION_KEY=

# Database (file-backed SQLite by default; survives restarts)
DATABASE_URL=sqlite:///./wallet.db

# Google Identity Services OAuth Client ID (same value as the frontend's
# NEXT_PUBLIC_GOOGLE_CLIENT_ID). Leave blank to disable Google sign-in.
GOOGLE_CLIENT_ID=

# Gemini API key from https://aistudio.google.com/apikey
# Leave blank to run without the LLM proxy (execute returns 503).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Session tuning
ACCESS_TOKEN_EXPIRE_MINUTES=720
VAULT_SESSION_MINUTES=5
PIN_MAX_ATTEMPTS=5
PIN_LOCKOUT_MINUTES=5
COOKIE_SECURE=false

# Comma-separated origins allowed to call the API directly
CORS_ORIGINS=http://localhost:3000

# Seed new accounts with 3 starter wallet cards + sample chat summaries
SEED_DEMO_DATA=true
