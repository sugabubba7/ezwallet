# ------------------------------------------------------------------
# EZ Wallet backend settings: every variable the app reads.
#
# Files, highest priority first:
#   real environment variables > backend/.env.local > backend/.env
#   backend/.env        committed; throwaway grading DB + non-secrets
#   backend/.env.local  git-ignored; your personal keys + generated secrets
# ------------------------------------------------------------------

# --- Database ------------------------------------------------------
# PostgreSQL URL (postgres:// or postgresql://; Neon/Render/Supabase format)
# or a SQLite file for fully offline use: sqlite:///./wallet.db
DATABASE_URL=sqlite:///./wallet.db

# --- Secrets (NEVER commit real values) ----------------------------
# Signs login tokens. 32+ random chars.
JWT_SECRET=
# Fernet key that encrypts wallet cards at rest.
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
WALLET_ENCRYPTION_KEY=
# true = if the two secrets above are missing, generate them on first run
# and save them to backend/.env.local (local development / grading).
AUTO_GENERATE_SECRETS=true

# --- Optional integrations (personal keys go in .env.local) --------
# Gemini API key from https://aistudio.google.com/apikey (blank = LLM proxy returns 503)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Google OAuth Web Client ID (blank = Google sign-in hidden)
GOOGLE_CLIENT_ID=

# --- Grading account (created on startup if missing) ---------------
GRADER_USERNAME=NYUgrader
GRADER_PASSWORD=Courant2026!
GRADER_PIN=2026

# --- Tuning ---------------------------------------------------------
ACCESS_TOKEN_EXPIRE_MINUTES=720
VAULT_SESSION_MINUTES=5
PIN_MAX_ATTEMPTS=5
PIN_LOCKOUT_MINUTES=5
# true when served over HTTPS (production)
COOKIE_SECURE=false
# Origins allowed to call the API directly from a browser (comma-separated)
CORS_ORIGINS=http://localhost:3000
# New accounts get 3 starter wallet cards + 5 sample chat summaries
SEED_DEMO_DATA=true
