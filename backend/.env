# ==================================================================
# WORKING .env FOR GRADING (committed on purpose)
#
# Contains ONLY throwaway / public values:
#   - DATABASE_URL: a throwaway database made just for this assignment
#   - the course's published grading login
#   - non-secret settings
#
# The real secrets (JWT_SECRET, WALLET_ENCRYPTION_KEY) are NOT here.
# They're generated on first run into backend/.env.local (git-ignored).
# Personal API keys (Gemini, Google) also belong in .env.local, never here.
# Full list of variables: .env.example
# ==================================================================

DATABASE_URL=sqlite:///./wallet.db

AUTO_GENERATE_SECRETS=true

GRADER_USERNAME=NYUgrader
GRADER_PASSWORD=Courant2026!
